# GhostTweak Website Configuration

# Live Payment Switch: set to 'true' once your payment gateway is ready.
# When 'false', the checkout modal runs in Safe Mode (maintenance notice + contact form).
NEXT_PUBLIC_PAYMENT_ENABLED=false

# Payment Gateway URL (e.g. Stripe Payment Link, Lava, Boosty, YooKassa, Robokassa)
NEXT_PUBLIC_PAYMENT_URL=https://buy.stripe.com/your_payment_link_here

# Administrator & Support Contacts
NEXT_PUBLIC_ADMIN_EMAIL=admin@ghosttweak.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@ghosttweak.com

# Community Discord Invite URL (Optional)
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/ghosttweak
