# GhostTweak Build & Code Signing Configuration (Optional)
# If provided, build.bat will automatically sign releases/GhostTweak_Portable.exe with signtool.exe

# Path to your Authenticode code-signing certificate (.pfx or .p12)
# SIGNTOOL_KEY_PATH=C:\path\to\your\certificate.pfx

# Password for your certificate file
# SIGNTOOL_PASSWORD=your_certificate_password_here
